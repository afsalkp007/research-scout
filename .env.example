# Choose provider: "gemini", "openai", or "mock"
LLM_PROVIDER=gemini

# Google Gemini API Key (Get free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional: Tavily Search API Key (If not provided, falls back to DuckDuckGo/Mock)
TAVILY_API_KEY=your_tavily_api_key_here
